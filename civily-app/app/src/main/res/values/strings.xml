    <!--
      How long until, in figures. Two renderings of one `Countdown`: the compact form for a line
      with a phrase of room, the clock for a screen whose subject is the wait. No plurals — every
      form here is a unit abbreviation or a fixed-shape clock, neither of which inflects.
    -->
    <string name="countdown_days">%1$dd %2$dh</string>
    <string name="countdown_hours">%1$dh %2$dm</string>
    <string name="countdown_minutes">%1$dm</string>
