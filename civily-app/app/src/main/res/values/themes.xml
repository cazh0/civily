<resources>
    <!--
        The Activity theme exists only to paint the window before Compose takes over; all
        real styling lives in ui/theme. Parenting to the platform theme avoids pulling in
        AppCompat or the Material View library for a single style declaration (spec §1.4).
    -->
    <style name="Theme.Civily" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
